<UserControl x:Class="CaptureOk.Editor.HistoryPanel" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:CaptureOk.Editor">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <SolidColorBrush x:Key="CurrentFrameBrush" Color="#FF3B82F6" />
        <SolidColorBrush x:Key="UnsavedDotBrush" Color="#FFFF9500" />
    </UserControl.Resources>
    <DockPanel>
        <TextBlock x:Name="Header" DockPanel.Dock="Top" Margin="10,8,10,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="6,4,6,8">
            <ui:Button x:Name="SaveAllButton" Focusable="False" Icon="{ui:SymbolIcon SaveMultiple24}" Content="모두 저장" ToolTip="목록의 캡처를 한 폴더에 모두 저장"
                       HorizontalAlignment="Stretch" Margin="2,0" Padding="4,4" FontSize="12" />
            <ui:Button x:Name="ClearButton" Focusable="False" Icon="{ui:SymbolIcon DeleteDismiss24}" Content="비우기" ToolTip="목록 비우기 (고정한 캡처는 남김)"
                       HorizontalAlignment="Stretch" Margin="2,0" Padding="4,4" FontSize="12" />
        </UniformGrid>
        <Grid>
            <TextBlock x:Name="EmptyText" Text="캡처가 없습니다" Margin="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,3" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <!-- 기본 선택 표시 대신 항목 안의 테두리로 "지금 편집 중"을 보여 준다 -->
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:HistoryItem}">
                        <Border x:Name="Frame" CornerRadius="5" BorderThickness="2" Padding="3" BorderBrush="Transparent"
                                Background="{DynamicResource ControlFillColorDefaultBrush}" ToolTip="{Binding ToolTip}">
                            <StackPanel>
                                <Grid>
                                    <Image Source="{Binding Thumbnail}" MaxHeight="150" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" />
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource UnsavedDotBrush}" Stroke="#B0000000" StrokeThickness="1"
                                             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3"
                                             Visibility="{Binding IsDirty, Converter={StaticResource Visible}}" />
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2" Padding="2" CornerRadius="3" Background="#B0202020"
                                            Visibility="{Binding IsPinned, Converter={StaticResource Visible}}">
                                        <ui:SymbolIcon Symbol="Pin16" Filled="True" FontSize="13" Foreground="White" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Caption}" Margin="2,3,2,0" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource CurrentFrameBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
